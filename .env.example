# --- Chat: OpenAI real vs mock (sin clave) ---
# mock     = chat en local sin API key (orquesta las mismas herramientas; útil para demo/defensa)
# openai   = requiere OPENAI_API_KEY con valor sk-... (no dejar la línea vacía)
# (vacío)  = si OPENAI_API_KEY tiene valor → openai; si está vacía → mock automático
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Límites del agente
AGENT_MAX_ITERATIONS=25
LLM_TIMEOUT_MS=60000

# Servidor
PORT=3001
